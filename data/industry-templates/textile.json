  "verification_questions": [
    {
      "question_id": "TEXTILE-Q-001",
      "prompt": "Which processes are performed onsite: spinning, weaving, knitting, wet processing, printing, drying, finishing or garment making?",
      "required_for_source_type_ids": ["outsourced_manufacturing"]
    },
    {
      "question_id": "TEXTILE-Q-002",
      "prompt": "Which fuels are used in boilers, thermic-fluid heaters, stenters, dryers, ovens and generators?",
      "required_for_source_type_ids": ["stationary_fuel_combustion"]
    },
    {
      "question_id": "TEXTILE-Q-003",
      "prompt": "Is steam or heat generated onsite or purchased from another facility?",
      "required_for_source_type_ids": ["stationary_fuel_combustion", "purchased_heat_steam_cooling"]
    },
    {
      "question_id": "TEXTILE-Q-004",
      "prompt": "Which fibres, yarns, fabrics, dyes and chemicals are purchased, and what quantities are available?",
      "required_for_source_type_ids": ["purchased_materials"]
    },
    {
      "question_id": "TEXTILE-Q-005",
      "prompt": "Can any dyeing, printing, curing, coating or treatment process directly release a greenhouse gas apart from combustion?",
      "required_for_source_type_ids": ["industrial_process_emissions"]
    },
    {
      "question_id": "TEXTILE-Q-006",
      "prompt": "Which chillers or air-conditioning systems contain refrigerants, and were any refrigerants added or removed?",
      "required_for_source_type_ids": ["refrigerant_fugitive_emissions"]
    },
    {
      "question_id": "TEXTILE-Q-007",
      "prompt": "How much wastewater is generated, how is it treated, and what happens to sludge and reject streams?",
      "required_for_source_type_ids": ["onsite_wastewater_treatment", "offsite_wastewater_treatment", "waste_generated_in_operations"]
    },
    {
      "question_id": "TEXTILE-Q-008",
      "prompt": "Which inbound and outbound transport activities use company-controlled vehicles and which use third-party carriers?",
      "required_for_source_type_ids": ["mobile_fuel_combustion", "upstream_transportation", "downstream_transportation"]
    }
  ]
