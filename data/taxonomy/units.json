    "allow_only_within_same_dimension": true,
    "formula": "normalized_quantity = original_quantity * to_base_multiplier",
    "negative_quantities_allowed": false,
    "preserve_original_value": true,
    "cross_dimension_conversion": "Requires a separately sourced and versioned material-specific conversion factor.",
    "rounding": "ROUND_FOR_DISPLAY_ONLY"
